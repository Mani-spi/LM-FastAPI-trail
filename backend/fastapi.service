
[Unit]
Description=FastAPI application
After=network.target

[Service]
# Adjust User/Group to your VPS user
User=u123456789
Group=u123456789
WorkingDirectory=/home/u123456789/myapi
Environment="PATH=/home/u123456789/myapi/venv/bin"
EnvironmentFile=/home/u123456789/myapi/.env
ExecStart=/home/u123456789/myapi/venv/bin/gunicorn -k uvicorn.workers.UvicornWorker app.main:app --bind 0.0.0.0:8001

[Install]
WantedBy=multi-user.target
